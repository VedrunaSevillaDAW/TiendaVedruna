---
import Layout from "../../components/Layout.astro";
---

<Layout title="Pago confirmado">
  <section class="max-w-xl mx-auto rounded-3xl bg-white/90 border border-[rgba(0,178,227,0.2)] p-8 shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)] text-center">
    <p class="text-[11px] uppercase tracking-[0.28em] font-semibold text-[#007da0]">Pago</p>
    <h1 class="mt-3 text-2xl font-['Poppins',_sans-serif] font-semibold text-[#3b3b3b]">
      Confirmando tu compra
    </h1>
    <p class="mt-3 text-sm text-[#4a4a4a]">
      Estamos verificando el estado del pago y te redirigimos al inicio.
    </p>
  </section>
</Layout>
