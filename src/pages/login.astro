---
import Layout from "../components/Layout.astro";
// Script cliente para flujo OAuth y logout.
import loginScript from "../scripts/login-page.ts?url";
// URL base del auth server para enlaces de registro/logout.
const authServerUrl = (
  import.meta.env.LOGIN_BASE_URL ||
  import.meta.env.PUBLIC_LOGIN_VEDRUNA_URL ||
  "http://localhost:9000"
).replace(/\/+$/, "");
---

<Layout title="Login">
  <div class="min-h-[70vh] flex items-center justify-center">
    <div
      class="w-full max-w-md rounded-3xl p-8 bg-white/90 border border-[rgba(0,178,227,0.2)] shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)]"
    >
      <h1 class="text-3xl md:text-4xl font-['Poppins',_sans-serif] font-semibold text-center mb-6 text-[#3b3b3b]">Log in</h1>

      <div
        id="login-error"
        class="mb-4 text-sm text-red-600 border border-red-200 rounded-2xl p-3 bg-red-50 hidden"
      ></div>
      <div id="login-logged-in" class="hidden space-y-5">
        <p class="text-sm text-[#4a4a4a] text-center">
          Sesion iniciada como <span id="login-username" class="font-semibold text-[#3b3b3b]"></span>.
        </p>
        <button
          id="login-logout"
          type="button"
          class="w-full inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold bg-white border border-[rgba(0,178,227,0.35)] text-[#007da0] hover:bg-[#e9f8fc] transition"
        >
          Desloguearte
        </button>
      </div>

      <div id="login-logged-out" class="space-y-5">
        <form id="login-form" class="space-y-5">
          <p class="text-sm text-[#4a4a4a]">
            Se abrira la autenticacion de Vedruna y volveras a esta tienda al completar el login.
          </p>
          <button type="submit" class="w-full inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold bg-[#00b2e3] text-white shadow-[0_14px_30px_-18px_rgba(0,125,160,0.8)] hover:bg-[#009bc7] transition">
            Acceder con Vedruna
          </button>
        </form>
        
      </div>
    </div>
  </div>
</Layout>

<script type="module" src={loginScript}></script>
