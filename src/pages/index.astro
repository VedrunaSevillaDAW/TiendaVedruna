---
import Layout from "../components/Layout.astro";

---

<Layout title="Tienda Vedruna">
  <section class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] items-center">
    <div class="rounded-3xl bg-white/90 border border-[rgba(0,178,227,0.2)] p-8 shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)]">
      <p class="text-[11px] uppercase tracking-[0.28em] font-semibold text-[#007da0]">Coleccion Vedruna</p>
      <h1 class="mt-4 text-3xl md:text-5xl font-['Poppins',_sans-serif] font-semibold text-[#3b3b3b]">
        Una tienda escolar con estilo contemporaneo.
      </h1>
      <p class="mt-4 text-base md:text-lg text-[#4a4a4a] leading-relaxed">
        Prendas y accesorios pensados para la comunidad Vedruna, con acabados
        cuidados, tonos frescos y una experiencia de compra clara y segura.
      </p>
      <div class="mt-6 flex flex-wrap gap-4 items-center">
        <a class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold bg-[#00b2e3] text-white shadow-[0_14px_30px_-18px_rgba(0,125,160,0.8)] hover:bg-[#0c71c3] transition" href="/productos">
          Ver productos
        </a>
        <a class="inline-flex items-center justify-center px-5 py-3 rounded-full text-sm font-semibold bg-white/80 border border-[rgba(0,178,227,0.3)] text-[#3b3b3b] hover:text-[#0c71c3] hover:border-[rgba(0,178,227,0.6)] transition" href="/about">
          Conoce el proyecto
        </a>
      </div>
    </div>

    <div class="relative flex items-center justify-center">
      <div class="absolute w-90 h-90 rounded-full bg-[radial-gradient(circle,rgba(0,178,227,0.25),rgba(0,178,227,0.05)_65%)] blur-[12px]"></div>
      <div class="relative z-10 w-94 h-94 rounded-[56px] flex items-center justify-center bg-white border border-[rgba(0,178,227,0.3)] shadow-[0_18px_40px_-24px_rgba(6,38,48,0.6)]">
        <div class="w-70 h-70 rounded-[44px] bg-[#f6fbfd] flex items-center justify-center">
          <img
            src="public/img/sudadera.png"
            alt="Modelo de sudadera"
            loading="lazy"
            class="w-94 h-94 object-contain"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-4 md:grid-cols-3 mt-10">
    <article class="rounded-2xl p-5 bg-white/85 border border-[rgba(0,178,227,0.18)] shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)]">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="w-7 h-7 text-[#00b2e3]"
      >
        <path fill="none" d="M0 0H24V24H0z" />
        <path d="M3 7h18v10H3z" />
        <path d="M7 7V5a5 5 0 0 1 10 0v2" />
      </svg>
      <h3 class="mt-3 font-semibold text-base text-[#3b3b3b]">Calidad seleccionada</h3>
      <p class="mt-2 text-sm leading-relaxed text-[#4a4a4a]">
        Tejidos comodos y resistentes, listos para el dia a dia del colegio.
      </p>
    </article>
    <article class="rounded-2xl p-5 bg-white/85 border border-[rgba(0,178,227,0.18)] shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)]">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="w-7 h-7 text-[#00b2e3]"
      >
        <path fill="none" d="M0 0H24V24H0z" />
        <path d="M12 2l7 7-7 7-7-7z" />
        <path d="M5 12v7h14v-7" />
      </svg>
      <h3 class="mt-3 font-semibold text-base text-[#3b3b3b]">Compra intuitiva</h3>
      <p class="mt-2 text-sm leading-relaxed text-[#4a4a4a]">
        Elige talla y color en segundos. Tu pedido llega con seguimiento claro.
      </p>
    </article>
    <article class="rounded-2xl p-5 bg-white/85 border border-[rgba(0,178,227,0.18)] shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)]">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="w-7 h-7 text-[#00b2e3]"
      >
        <path fill="none" d="M0 0H24V24H0z" />
        <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" />
        <circle cx="12" cy="9" r="2.5" />
      </svg>
      <h3 class="mt-3 font-semibold text-base text-[#3b3b3b]">Comunidad Vedruna</h3>
      <p class="mt-2 text-sm leading-relaxed text-[#4a4a4a]">
        Disenos pensados para sentir orgullo de pertenecer a la comunidad.
      </p>
    </article>
  </section>

</Layout>
