---
// Mezcla aleatoria para variar el orden del catalogo.
import shuffle from "lodash.shuffle";
import Layout from "../components/Layout.astro";
// Cliente API de Printful.
import { printful } from "../lib/printful-client";
// Normalizador de nombres de variantes.
import { formatVariantName } from "../lib/format-variant-name";
import type { PrintfulProduct } from "../types";
import ProductGrid from "../components/ProductGrid.astro";
// Script cliente para interacciones de tarjetas.
import productsScript from "../scripts/products-page.ts?url";

// Producto enriquecido con variantes.
type PrintfulProductWithVariants = PrintfulProduct & {
  variants: any[];
};

// Obtiene IDs sincronizados de productos en Printful.
const { result: productIds } = await printful.get("sync/products");

// Carga detalle completo de cada producto.
const allProducts = await Promise.all(
  productIds.map(async ({ id }) => await printful.get(`sync/products/${id}`))
);

// Mapea resultado a estructura consumible por la UI.
const products: PrintfulProductWithVariants[] = allProducts.map(
  ({ result: { sync_product, sync_variants } }) => ({
    ...sync_product,
    variants: sync_variants.map(({ name, ...variant }) => ({
      name: formatVariantName(name),
      ...variant,
    })),
  })
);

// Baraja listado para experiencia menos repetitiva.
const shuffledProducts = shuffle(products);
---

<Layout title="Nuestros Productos | Tienda Vedruna">
  <section class="pt-6 pb-6 md:pb-10">
    <div class="rounded-3xl bg-white/90 border border-[rgba(0,178,227,0.2)] p-8 shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)] text-center">
      <p class="text-[11px] uppercase tracking-[0.28em] font-semibold text-[#007da0]">Coleccion Vedruna</p>
      <h1 class="mt-4 text-3xl md:text-5xl font-['Poppins',_sans-serif] font-semibold text-[#3b3b3b]">
        Nuestros Productos
      </h1>
      <p class="mt-4 text-base md:text-lg text-[#4a4a4a] leading-relaxed">
        Descubre la coleccion actual y elige tus favoritos.
      </p>
    </div>
  </section>

  <ProductGrid products={shuffledProducts} />
</Layout>

<script type="module" src={productsScript}></script>
