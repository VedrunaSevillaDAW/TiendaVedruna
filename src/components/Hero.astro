---
const { product } = Astro.props as { product: { name: string } };
---

<div class="bg-gray-50 p-6 md:p-12">
  <div class="flex items-center">
    <div class="flex items-center justify-center flex-1 sm:flex-shrink-0 md:w-1/3 p-6">
      image
    </div>
    <div class="md:w-2/3">
      <h1 class="text-gray-900 text-xl md:text-3xl font-bold">
        {product?.name ?? ""}
      </h1>
    </div>
  </div>
</div>
