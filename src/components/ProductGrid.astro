---
// Componente de tarjeta individual de producto.
import ProductCard from "./ProductCard.astro";

// Lista de productos a renderizar en formato rejilla.
const { products = [] } = Astro.props as { products: any[] };
---

{products.length ? (
  <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
    {products.map((product) => (
      <ProductCard product={product} />
    ))}
  </div>
) : (
  <p class="text-center text-gray-500">No hay productos disponibles.</p>
)}
