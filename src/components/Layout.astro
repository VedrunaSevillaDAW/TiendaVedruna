---
// Estilos globales de la aplicacion.
import "../styles/global.css";
import "../styles/app.css";
// Script global del sitio (auth, wishlist, carrito, checkout).
import siteScript from "../scripts/site.ts?url";

// Titulo por defecto de documento.
const { title = "Nukko" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&family=Lato:wght@300;400;700;900&display=swap"
      rel="stylesheet"
    />
    <link href="/img/LOGO.png" rel="shortcut icon" />
  </head>
  <body class="antialiased min-h-screen text-[#3b3b3b] bg-[#f6fbfd] bg-[radial-gradient(circle_at_top,rgba(0,178,227,0.12),transparent_55%)] font-['Open_Sans',_sans-serif]">
    <div class="min-h-screen flex flex-col">
      <header class="sticky top-0 left-0 w-full bg-[#f6fbfd]/95 backdrop-blur border-b border-[rgba(0,178,227,0.25)] z-50">
        <div class="max-w-6xl mx-auto px-6 py-2 grid grid-cols-[1fr_auto_1fr] items-center">
          <nav class="hidden md:flex items-center gap-4 text-[11px] uppercase tracking-[0.2em] font-semibold text-[#3b3b3b] justify-self-start">
            <a class="hover:text-[#0c71c3] transition" href="/about">Sobre nosotros</a>
            <a class="hover:text-[#0c71c3] transition" href="/productos">Nuestros productos</a>
          </nav>

          <a class="flex items-center gap-3 text-left justify-self-center" href="/">
            <div class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden bg-white border border-[rgba(0,178,227,0.3)] shadow-[0_8px_18px_-12px_rgba(6,38,48,0.35)]">
              <img
                src="/img/LOGO2.png"
                alt="Vedruna Logo"
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="leading-none">
              <span class="block font-['Poppins',_sans-serif] text-sm font-semibold tracking-wide">Vedruna</span>
              <span class="block text-[10px] uppercase tracking-[0.25em] text-[#4a4a4a]">Tienda oficial</span>
            </div>
          </a>

          <div class="flex items-center justify-end justify-self-end">
            <div data-auth-state>
              <div data-auth-logged-in class="display flex hidden items-center gap-3 text-xs">
                <a class="text-xs font-semibold text-[#3b3b3b] hover:text-[#0c71c3] transition" href="/login" data-username></a>
                <a class="relative w-9 h-9 rounded-full flex items-center justify-center bg-white border border-[rgba(0,178,227,0.25)] text-[#3b3b3b] hover:text-[#00b2e3] transition shadow-[0_10px_24px_-18px_rgba(6,38,48,0.4)]" href="/wishlist">
                  <span
                    class="absolute top-2 right-2 w-2 h-2 rounded-full bg-[#0c71c3] hidden"
                    data-wishlist-indicator
                  ></span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                  >
                    <path fill="none" d="M0 0H24V24H0z" />
                    <path d="M12.001 4.529c2.349-2.109 5.979-2.039 8.242.228 2.262 2.268 2.34 5.88.236 8.236l-8.48 8.492-8.478-8.492c-2.104-2.356-2.025-5.974.236-8.236 2.265-2.264 5.888-2.34 8.244-.228z" />
                  </svg>
                </a>
                <button
                  class="relative w-9 h-9 rounded-full flex items-center justify-center bg-white border border-[rgba(0,178,227,0.25)] text-[#3b3b3b] hover:text-[#00b2e3] transition shadow-[0_10px_24px_-18px_rgba(6,38,48,0.4)] cursor-pointer"
                  aria-label="Cart"
                  type="button"
                  data-cart-button
                >
                  <span
                    class="absolute top-2 right-2 w-2 h-2 rounded-full bg-[#0c71c3] hidden"
                    data-cart-indicator
                  ></span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                  >
                    <path fill="none" d="M0 0h24v24H0z" />
                    <path d="M4 16V4H2V2h3a1 1 0 0 1 1 1v12h12.438l2-8H8V5h13.72a1 1 0 0 1 .97 1.243l-2.5 10a1 1 0 0 1-.97.757H5a1 1 0 0 1-1-1zm2 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm12 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4z" />
                  </svg>
                </button>
              </div>

              <div data-auth-guest class="flex items-center gap-3 text-xs">
                <a class="text-xs font-semibold text-[#3b3b3b] hover:text-[#0c71c3] transition" href="/login">Login</a>
                <a class="relative w-9 h-9 rounded-full flex items-center justify-center bg-white border border-[rgba(0,178,227,0.25)] text-[#3b3b3b] hover:text-[#00b2e3] transition shadow-[0_10px_24px_-18px_rgba(6,38,48,0.4)]" href="/wishlist">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                  >
                    <path fill="none" d="M0 0H24V24H0z" />
                    <path d="M12.001 4.529c2.349-2.109 5.979-2.039 8.242.228 2.262 2.268 2.34 5.88.236 8.236l-8.48 8.492-8.478-8.492c-2.104-2.356-2.025-5.974.236-8.236 2.265-2.264 5.888-2.34 8.244-.228z" />
                  </svg>
                </a>
                <button
                  class="relative w-9 h-9 rounded-full flex items-center justify-center bg-white border border-[rgba(0,178,227,0.25)] text-[#3b3b3b] hover:text-[#00b2e3] transition shadow-[0_10px_24px_-18px_rgba(6,38,48,0.4)] cursor-pointer"
                  aria-label="Cart"
                  type="button"
                  data-cart-button
                >
                  <span
                    class="absolute top-2 right-2 w-2 h-2 rounded-full bg-[#0c71c3] hidden"
                    data-cart-indicator
                  ></span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                  >
                    <path fill="none" d="M0 0h24v24H0z" />
                    <path d="M4 16V4H2V2h3a1 1 0 0 1 1 1v12h12.438l2-8H8V5h13.72a1 1 0 0 1 .97 1.243l-2.5 10a1 1 0 0 1-.97.757H5a1 1 0 0 1-1-1zm2 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm12 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="pt-8 pb-16 flex-1">
        <div class="max-w-6xl mx-auto px-6">
          <slot />
        </div>
      </main>

      <footer class="bg-[#0c71c3] text-white">
        <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col gap-4">
          <div class="flex flex-wrap items-center justify-center gap-6 text-xs md:text-sm font-semibold">
            <a class="hover:text-white/80 transition" href="/aviso-legal">Aviso Legal</a>
            <a class="hover:text-white/80 transition" href="/calidad">Calidad</a>
            <a class="hover:text-white/80 transition" href="/politica-cookies">Politica de Cookies</a>
            <a class="hover:text-white/80 transition" href="/politica-privacidad">Politica de Privacidad</a>
            <a class="hover:text-white/80 transition" href="/terminos-condiciones">Terminos y Condiciones</a>
          </div>
          <div class="flex flex-wrap items-center justify-center md:justify-center gap-4 text-xs md:text-sm">
            <p class="text-center md:text-center">
              &copy; {new Date().getFullYear()} Colegio Santa Joaquina de Vedruna | Fundacion Vedruna Educacion
            </p>
          </div>
        </div>
      </footer>
    </div>

    <div
      id="cart-panel"
      class="fixed top-0 right-0 h-full w-full max-w-md bg-white border-l border-[rgba(0,178,227,0.25)] shadow-[-16px_0_40px_-30px_rgba(6,38,48,0.55)] translate-x-full transition-transform duration-300 z-[100] flex flex-col"
      data-cart-panel
    >
      <div class="px-5 py-4 border-b border-[rgba(0,178,227,0.2)] flex items-center justify-between">
        <div>
          <p class="text-[11px] uppercase tracking-[0.2em] font-semibold text-[#007da0]">Carrito</p>
          <p class="text-sm text-[#4a4a4a]">
            <span class="simpleCart_quantity">0</span> items
          </p>
        </div>
        <button
          type="button"
          class="text-xs font-semibold tracking-[0.12em] uppercase hover:text-[#007da0] transition"
          data-cart-close
        >
          Cerrar
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-5">
        <div class="simpleCart_items"></div>
      </div>

      <div class="p-5 border-t border-[rgba(0,178,227,0.2)] space-y-4">
        <div class="flex items-center justify-between text-sm">
          <span class="text-[#4a4a4a]">Total</span>
          <span class="font-semibold text-[#3b3b3b] simpleCart_total"></span>
        </div>
        <p class="text-xs text-[#4a4a4a] hidden" data-cart-message></p>
        <button
          type="button"
          class="w-full inline-flex items-center justify-center px-5 py-3 rounded-full text-sm font-semibold bg-[#00b2e3] text-white hover:bg-[#009bc7] transition"
          data-cart-checkout
        >
          Comprar
        </button>
        <button
          type="button"
          class="w-full inline-flex items-center justify-center px-3 py-2 rounded-full text-xs font-semibold border border-[rgba(0,178,227,0.35)] text-[#007da0] hover:bg-[#e9f8fc] transition"
          data-cart-empty
        >
          Vaciar carrito
        </button>
      </div>
    </div>
    <div class="fixed inset-0 bg-[#062630]/30 opacity-0 pointer-events-none transition-opacity duration-300 z-[90]" data-cart-backdrop></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplecartjs/3.0.5/simplecart.min.js"></script>
    <script type="module" src={siteScript}></script>
  </body>
</html>
