---
import type { PrintfulProduct } from "../types";
import VariantPicker from "./VariantPicker.astro";

type ProductWithVariants = PrintfulProduct & {
  variants: any[];
};

const { product } = Astro.props as { product: ProductWithVariants };

const variants = product.variants ?? [];
const [firstVariant] = variants;
const previewFile =
  firstVariant?.files?.find((file: any) => file.type === "preview") ?? null;

const formatPrice = (value: number, currency: string) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency,
  }).format(value);
---

<article
  class="relative overflow-hidden  rounded-3xl flex flex-col bg-white/90 border border-[rgba(0,178,227,0.2)] shadow-[0_18px_40px_-30px_rgba(6,38,48,0.45)] transition hover:-translate-y-1 hover:border-[rgba(0,178,227,0.5)]"
  data-product-card
  data-product-id={product.id}
  data-product-name={product.name}
  data-variants={JSON.stringify(variants)}
>
  <button
    type="button"
    aria-label="Add to wishlist"
    class="absolute top-4 right-4 w-10 h-10 rounded-full flex items-center justify-center bg-white/90 border border-[rgba(0,178,227,0.25)] text-[#4a4a4a] hover:text-[#d45555] hover:border-[rgba(212,85,85,0.4)] transition"
    data-wishlist-button
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="w-6 h-6 fill-current"
      data-wishlist-icon
    >
      <path fill="none" d="M0 0H24V24H0z" />
      <path d="M12.001 4.529c2.349-2.109 5.979-2.039 8.242.228 2.262 2.268 2.34 5.88.236 8.236l-8.48 8.492-8.478-8.492c-2.104-2.356-2.025-5.974.236-8.236 2.265-2.264 5.888-2.34 8.244-.228z" />
    </svg>
  </button>

  <div class="w-full h-56 flex items-center justify-center p-6 ">
    {previewFile ? (
      <img
        src={previewFile.preview_url}
        width="250"
        height="250"
        alt={`${firstVariant?.name ?? ""} ${product.name}`}
        title={`${firstVariant?.name ?? ""} ${product.name}`}
        loading="lazy"
        data-product-image
      />
    ) : (
      <div class="w-[250px] h-[250px] bg-white/60"></div>
    )}
  </div>

  <div class="flex-1 px-6 pb-4">
    <div class="text-center">
      <p class="mb-1 font-semibold text-base text-[#3b3b3b]">{product.name}</p>
      <p class="text-sm text-[#4a4a4a]" data-product-price>
        {firstVariant
          ? formatPrice(firstVariant.retail_price, firstVariant.currency)
          : ""}
      </p>
    </div>
  </div>

  <div class="px-6 pb-6 flex flex-col sm:flex-row justify-center items-center gap-3">
    <VariantPicker variants={variants} />

    <button
      class="w-full md:w-auto inline-flex items-center justify-center px-5 py-2 rounded-full text-sm font-semibold bg-[#00b2e3] text-white hover:bg-[#009bc7] transition"
      data-add-to-cart
      data-item-id={firstVariant?.external_id ?? ""}
      data-item-price={firstVariant?.retail_price ?? ""}
      data-item-url={`/api/products/${firstVariant?.external_id ?? ""}`}
      data-item-description={firstVariant?.name ?? ""}
      data-item-image={previewFile?.preview_url ?? ""}
      data-item-name={product.name}
      data-auth-required
      type="button"
    >
      Añadir
    </button>
  </div>
</article>
