<div
  class="fixed top-4 right-4 items-center bg-white shadow-lg p-2 rounded-full border border-gray-300 hidden"
  data-user-avatar
>
  <img
    src="/default-avatar.png"
    alt="Usuario"
    class="w-10 h-10 rounded-full mr-2"
  />
  <span class="font-medium text-gray-700" data-user-avatar-name></span>
</div>

<script>
  const avatar = document.querySelector("[data-user-avatar]");
  const nameEl = document.querySelector("[data-user-avatar-name]");
  const username = window.localStorage.getItem("username");

  if (avatar && nameEl && username) {
    nameEl.textContent = username;
    avatar.classList.remove("hidden");
  }
</script>
